# ========================================
# OOTD - 환경 변수 템플릿
# 이 파일을 복사해서 .env 파일로 만드세요
# cp .env.example .env
# ========================================

# ===== Database =====
DATABASE_URL="postgresql://ootd_user:ootd_password@localhost:5432/ootd_db"
REDIS_URL="redis://localhost:6379"

# ===== JWT Secrets (강력한 랜덤 문자열로 교체하세요) =====
JWT_ACCESS_SECRET="change-me-to-strong-random-secret-access"
JWT_REFRESH_SECRET="change-me-to-strong-random-secret-refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ===== AWS =====
AWS_REGION="ap-northeast-2"
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_S3_BUCKET_USER_IMAGES="ootd-user-images"
AWS_S3_BUCKET_PROCESSED_IMAGES="ootd-processed-images"
AWS_S3_BUCKET_GENERATED_IMAGES="ootd-generated-images"

# ===== AI APIs =====
ANTHROPIC_API_KEY="sk-ant-your-key-here"
OPENWEATHER_API_KEY="your-openweather-key"

# ===== Social Login =====
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
KAKAO_CLIENT_ID="your-kakao-client-id"
APPLE_CLIENT_ID="your-apple-client-id"
APPLE_TEAM_ID="your-apple-team-id"
APPLE_KEY_ID="your-apple-key-id"

# ===== Email (SMTP) =====
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="OOTD <noreply@ootd.app>"

# ===== Service Ports =====
AUTH_SERVICE_PORT=3001
WARDROBE_SERVICE_PORT=3002
OUTFIT_SERVICE_PORT=3003
AI_ORCHESTRATION_PORT=8001
RECOMMENDATION_PORT=8002
AVATAR_SERVICE_PORT=8003

# ===== Frontend =====
VITE_API_BASE_URL="http://localhost:3000/api/v1"
VITE_WS_URL="ws://localhost:3000/ws"

# ===== App =====
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"
