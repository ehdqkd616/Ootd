# ========================================
# OOTD - 환경 변수 템플릿
# 이 파일을 복사해서 .env 파일로 만드세요
# cp .env.example .env
# ========================================

# ===== Database =====
DATABASE_URL="postgresql://ootd_user:ootd_password@localhost:5434/ootd_db"
REDIS_URL="redis://localhost:6381"

# ===== Admin =====
# auth 서비스 시작 시 승인된 관리자 계정을 만든다 (이미 있으면 비밀번호는 바꾸지 않음)
# 회원가입은 모두 승인 대기 상태로 생성되므로, 첫 관리자는 이 값으로만 만들 수 있다
ADMIN_LOGIN_ID="admin"
ADMIN_PASSWORD="change-me"

# ===== 가입 알림 메일 =====
# 회원가입 시 관리자에게 승인 요청 메일을 보낸다. SMTP_USER/SMTP_PASSWORD나 수신자가 비어 있으면 건너뜀
# Gmail은 2단계 인증 + 앱 비밀번호 사용 (465면 SSL, 그 외는 STARTTLS)
# 수신자는 쉼표로 여러 명, PUBLIC_WEB_URL은 메일 속 관리자 페이지 링크
ADMIN_NOTIFY_EMAILS=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
PUBLIC_WEB_URL="https://ootd.hotgarlic.dedyn.io"

# ===== JWT Secrets (강력한 랜덤 문자열로 교체하세요) =====
JWT_ACCESS_SECRET="change-me-to-strong-random-secret-access"
JWT_REFRESH_SECRET="change-me-to-strong-random-secret-refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ===== AWS =====
AWS_REGION="ap-northeast-2"
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_S3_BUCKET_USER_IMAGES="ootd-user-images"
AWS_S3_BUCKET_PROCESSED_IMAGES="ootd-processed-images"
AWS_S3_BUCKET_GENERATED_IMAGES="ootd-generated-images"

# ===== AI APIs =====
ANTHROPIC_API_KEY="sk-ant-your-key-here"
OPENWEATHER_API_KEY="your-openweather-key"

# ===== Service Ports =====
AUTH_SERVICE_PORT=3001
WARDROBE_SERVICE_PORT=3002
OUTFIT_SERVICE_PORT=3003
AI_ORCHESTRATION_PORT=8001
RECOMMENDATION_PORT=8002
AVATAR_SERVICE_PORT=8003

# ===== Frontend =====
VITE_API_BASE_URL="http://localhost:3200/api/v1"
VITE_WS_URL="ws://localhost:3200/ws"

# ===== App =====
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5175"
